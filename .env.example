# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_platform

# Execution Mode: mock, azure, on_prem
EXECUTION_MODE=mock

# Azure OpenAI Configuration
# IMPORTANT: Never commit actual API keys to version control!
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Azure Computer Vision (OCR)
AZURE_VISION_ENDPOINT=https://your-vision-endpoint.cognitiveservices.azure.com/
AZURE_VISION_KEY=your-vision-key-here

# Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-it-in-production

# Frontend Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Tavily Search API (for AI PPT Generator)
TAVILY_API_KEY=your-tavily-api-key-here
