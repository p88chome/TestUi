# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_platform

# Execution Mode: mock, azure, on_prem
EXECUTION_MODE=mock

# Azure OpenAI Configuration
# IMPORTANT: Never commit actual API keys to version control!
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Azure Computer Vision (OCR)
AZURE_VISION_ENDPOINT=https://your-vision-endpoint.cognitiveservices.azure.com/
AZURE_VISION_KEY=your-vision-key-here

# Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-it-in-production

# Frontend Origin (for CORS and Email Verification Links)
CLIENT_ORIGIN=http://localhost:5173

# Environment: "development" or "production"
# In production (Azure), set ENV=production to disable localhost CORS
ENV=development

# Tavily Search API (for AI PPT Generator)
TAVILY_API_KEY=your-tavily-api-key-here

# ── Email Service ────────────────────────────────────────────────────────────
# Option 1: Disable (development / testing only)
EMAIL_PROVIDER=none

# Option 2: SMTP (Gmail / Outlook / Company SMTP)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_app_password   # Gmail: 2FA -> App Password (16 digits)
# EMAIL_FROM=no-reply@yourcompany.com
# EMAIL_FROM_NAME=AI Platform

# Option 3: Azure Communication Services Email (Recommended for enterprise)
# EMAIL_PROVIDER=azure_acs
# ACS_CONNECTION_STRING=endpoint=https://xxx.communication.azure.com/;accesskey=xxx
# ACS_SENDER_ADDRESS=DoNotReply@xxx.azurecomm.net
# ──────────────────────────────────────────────────────────────────────────────
