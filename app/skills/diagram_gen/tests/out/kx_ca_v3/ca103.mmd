flowchart TD
    %% CA-103 不動產、廠房及設備保全作業
    start(["開始"])
    n1["評估資產價值"]
    n1_doc0[/"📄 財產目錄清冊"/]
    n1 -.-> n1_doc0
    n2["填寫投保申請"]
    n2_doc0[/"📄 簽呈"/]
    n2 -.-> n2_doc0
    d1{"簽核"}
    n3["辦理投保/續保/退保"]
    n4["定期檢查資產"]
    n5["回報檢查結果"]
    n6["確認投保狀況"]
    d2{"是否需調整保險"}
    n7["辦理保險調整"]
    n8["通知保險公司處理損害"]
    n9["辦理契約變更"]
    _end(["結束"])
    start --> n1
    n1 --> n2
    n2 --> d1
    d1 -->|Y| n3
    d1 -->|N| n2
    n3 --> _end
    n4 --> n5
    n5 --> n6
    n6 --> d2
    d2 -->|Y| n7
    d2 -->|N| _end
    n7 --> _end
    n8 --> _end
